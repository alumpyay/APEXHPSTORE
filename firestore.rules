rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security check: Only verified admin email can access management features
    function isAdmin() {
      return request.auth != null 
             && request.auth.token.email_verified == true 
             && request.auth.token.email == 'alumpy841@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /orders/{orderId} {
      // Anyone can place an order
      allow create: if true;
      
      // VULNERABILITY FIX: Prevent list scraping. 
      // Customers can ONLY get their specific order if they know the exact random Tracking ID.
      // They cannot list or query all orders to steal customer data.
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }
    
    match /site_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /payment_accounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /delivery_rates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
